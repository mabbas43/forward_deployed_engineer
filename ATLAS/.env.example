# Copy to .env (never commit .env). Leave keys empty to run fully OFFLINE (heuristic model, simulated cost).
ATLAS_PROVIDER=auto                 # auto | offline
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PRIMARY_MODEL=gpt-4.1-mini
BACKUP_MODEL=claude-sonnet-4-5
STRONG_MODEL=gpt-4.1
JUDGE_MODEL=gpt-4.1-2025-04-14      # pin a dated snapshot for judges (P7: judge drift)

# LangSmith — EU region from day one (P6 data residency)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=atlas-dev
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

JWT_SECRET=change-me-to-32+-random-bytes-in-every-environment
IT_MCP_URL=http://127.0.0.1:8001/mcp
DATA_DIR=.atlas

# P8 infra (docker compose / AWS)
# QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/123456789012/atlas-tickets.fifo
# REDIS_URL=redis://localhost:6379/0
# DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
